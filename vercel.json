{
    "version": 2,
    "builds": [
    {
        "src": "app.js",
        "use": "@vercel/node"
    }
    ],
    "routes": [
    {
        "src": "/images/(.)",
        "dest": "/src/public/images/$1"
    },
    {
        "src": "/css/(.)",
        "dest": "/src/public/css/$1"
    },
    {
        "src": "/(.*)",
        "dest": "/app.js"
    }
    ]
}