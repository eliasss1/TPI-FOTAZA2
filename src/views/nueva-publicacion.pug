extends layout

block content
    div.container.bg-white.shadow-lg.p-5.rounded(style="min-height: calc(100vh - 5rem);")
        h1.text-center.mb-4 Crea tu publicación
        
        form.flex-column.d-flex(action="/publicaciones/crear" method="POST" enctype="multipart/form-data")

            .mb-3
                label.form-label(for="titulo") Título de la publicación 
                input#titulo.form-control(type="text" name="titulo" placeholder="Ej: Atardecer en las sierras" required)
            
            .mb-3
                label.form-label(for="descripcion") Descripción
                textarea#descripcion.form-control(name="descripcion" rows="3" required)
            
            .mb-3
                label.form-label(for="imagenes") Selecciona tus fotos
                input#imagenes.form-control(type="file" name="imagenes" accept="image/*" multiple required)
                .form-text Podes seleccionar más de una.
            
            .mb-3
                label.form-label.fw-semibold(for="etiquetas") Etiquetas / Tags
                input#etiquetas.form-control(type="text" name="etiquetas" placeholder="Ej: paisajes, naturaleza, verano" required)
                .form-text Escribí las palabras clave separadas por comas.
            
            .mb-3
                label.form-label.fw-semibold(for="tipo_licencia") Tipo de Licencia
                select#tipo_licencia.form-select(name="tipo_licencia" required)
                    option(value="sin_copyright") Sin Copyright (Contenido Público)
                    option(value="con_copyright") Con Copyright (Protegida)
            
            .mb-3
                label.form-label.fw-semibold(for="marca_agua") Texto de la Marca de Agua
                input#marca_agua.form-control(type="text" name="marca_agua" placeholder="Ej: © Tu Nombre")
            
            .mb-3.form-check.form-switch
                input.form-check-input(type='checkbox', role='switch', id='comentarios', name='comentarios', checked)
                label.form-check-label(for='comentarios') Permitir Comentarios
            
            button.btn.btn-primary.btn-lg.w-100(type="submit") Publicar Fotaza