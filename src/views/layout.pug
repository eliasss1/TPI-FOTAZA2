doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title FOTAZA 2
    //- Agregamos Bootstrap para que los pibes tengan clases CSS listas para usar
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css")

    style. 
      .menu-colapsable {
        width: 60px;
        white-space: nowrap;
        overflow: hidden; 
        transition: width 0.3s ease;
      }
      .menu-colapsable .menu-icono {
        width: 32px; 
        height: 32px; 
        object-fit: contain;
        transition: transform 0.3s ease;
      }
      .menu-colapsable:hover .menu-icono {
        transform: scale(1.1);
      }
      .barra-encabezado {
        height: 0;
        white-space: nowrap;
        overflow: hidden;
        transition: height 0.3s ease;
      }
      .barra-encabezado:hover {
        height: 60px;
      }
      .menu-colapsable:hover{
        width: 300px;
      }

  body.bg-light
    nav.barra-encabezado.navbar.navbar-dark.bg-dark
      div.container.mt-1
        a.navbar-brand(href="/") FOTAZA 2
        div.ms-auto.d-flex.gap-2
          if usuario
            span.text-light.my-auto Hola, #{usuario.username}
            a.btn.btn-danger.btn-sm(href="/auth/logout") Cerrar Sesión
          else
            a.btn.btn-outline-light.btn-sm(href="/auth/login") Iniciar Sesión
            a.btn.btn-primary.btn-sm(href="/auth/registro") Registrarse

    //- Poner las vistas acá
    main.d-flex(style="min-height: 85vh")
      div
        aside.menu-colapsable.flex-column.shadow-lg.bg-white(style="height: calc(100vh - 1rem)")
          ul.nav.flex-column.gap-2
            li.nav-item
              a.nav-link.p-2.link-dark.fw-semibold(href="/") 
                img.menu-icono.ms-2.me-3(src="/images/casa.png" alt="Icono")
                span Inicio
            
            
            if usuario
              li.nav-item
                a.nav-link.p-2.link-dark.fw-semibold(href="/nueva-publicacion") 
                  img.menu-icono.ms-2.me-3(src="/images/Subir.png" alt="Icono")
                  span Subir Foto
              li.nav-item
                a.nav-link.p-2.link-dark.fw-semibold(href="/perfil") 
                  img.menu-icono.ms-2.me-3(src="/images/usuario.png" alt="Icono")
                  span Mi Perfil
              li.nav-item
                a.nav-link.p-2.link-dark.fw-semibold(href="/notificaciones") 
                  img.menu-icono.ms-2.me-3(src="/images/notificaciones.png" alt="Icono")
                  span Notificaciones
              li.nav-item
                a.nav-link.p-2.link-dark.fw-semibold(href="/colecciones") 
                  img.menu-icono.me-3(src="/images/guardar.png" alt="Icono" style="heigth: 28px; width: 28px; margin-left: 10px")
                  span Colecciones

              if usuario.rol === 'validador'
                li.nav-item
                  a.nav-link.p-2.link-danger.fw-semibold(href="/moderacion") 
                    i.bi.bi-shield-lock-fill.ms-2.me-3.fs-4
                    span Moderación


      div.container.mt-auto.mb-auto  
          block content

    footer.bg-dark.text-light.text-center.py-3.mt-auto
      div.container
        p.mb-0 &copy; 2024 FOTAZA 2. Desarrollado por Maxi, Elias y Vic.

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script.
      document.addEventListener('mousemove', (e) => {
        const barra = document.querySelector('.barra-encabezado');
        const distanciaAlTecho = e.clientY; 
        if (distanciaAlTecho < 90) {   
          barra.style.height = '60px';
        } else {
          barra.style.height = '0px';
        }
      });