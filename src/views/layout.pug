doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title FOTAZA 2
    //- Agregamos Bootstrap para que los pibes tengan clases CSS listas para usar
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      div.container
        a.navbar-brand(href="/") FOTAZA 2
        div.ms-auto.d-flex.gap-2
          a.btn.btn-outline-light.btn-sm(href="/auth/login") Iniciar Sesión
          a.btn.btn-primary.btn-sm(href="/auth/registro") Registrarse
    //- Poner las vistas acá
    main.container.d-flex.flex-column.justify-content-center.align-items-center(style="min-height: 85vh;")
      div.w-100
        block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")