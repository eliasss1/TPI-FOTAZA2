doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title FOTAZA 2
    //- Agregamos Bootstrap para que los pibes tengan clases CSS listas para usar
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      div.container
        a.navbar-brand(href="/") FOTAZA 2
        div.ms-auto.d-flex.gap-2
          a.btn.btn-outline-light.btn-sm(href="/auth/login") Iniciar Sesión
          a.btn.btn-primary.btn-sm(href="/auth/registro") Registrarse
    //- Poner las vistas acá
    main.container-fluid.px-4.mt-4.d-flex.flex-column(style="min-height: calc(100vh - 9rem);")


      div.w-100.d-flex.flex-column.flex-md-row.gap-4.align-items-stretch.h-100
        aside.col-12.col-md-3.bg-white.shadow-lg.p-4.d-flex.flex-column
          h5.fw-bold.mb-3 Menú
          ul.nav.flex-column.gap-2
            li.nav-item
              a.nav-link.p-2.link-dark.fw-semibold(href="/") 
                i.bi.bi-house-door.me-2

                |  Inicio
            li.nav-item
              a.nav-link.p-2.link-dark.fw-semibold(href="/nueva-publicacion") 
                i.bi.bi-plus-circle.me-2

                |  Subir Foto
            li.nav-item
              a.nav-link.p-2.link-dark.fw-semibold(href="/perfil") 
                i.bi.bi-person.me-2

                |  Mi Perfil
        section.col-12.col-md-9.d-flex.flex-column
          block content
    footer.bg-dark.text-light.text-center.py-3.mt-auto
      div.container
        p.mb-0 &copy; 2024 FOTAZA 2. Desarrollado por Maxi, Elias y Vic.

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")