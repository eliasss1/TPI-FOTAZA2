extends layout

block content

    div.container.bg-white.rounded-1.shadow-lg.p-4.d-flex.flex-column(style="height: calc(100vh - 5rem);")
        
        //Barra de busqueda
        div.row.mb-4.justify-content-center
            div.col-md-8
                form.d-flex.gap-2(action="/buscar" method="GET")
                    input.form-control.border-2(type="text" name="query" placeholder="Buscar colecciones, o etiquetas...")
                    button.btn.btn-primary(type="submit") Buscar
        div.d-flex.flex-row.justify-content-between.p-3.mb-4.border-top.border-1
            h3.fw-bold.text-secondary Mis Colecciones
            div.d-flex.gap-2.align-items-center
                h5.text-muted Agregar coleccion
                button.btn.btn-secondary(type="button" data-bs-toggle="modal" data-bs-target=`#modalColeccion-${usuario.id}`) +
        //VENTANA MODAL DE AGREGAR COLECCION
            div.modal.fade(id=`modalColeccion-${publicacion.id}`)
            div.modal-dialog.modal-dialog-centered
                div.modal-content.border-0.shadow-lg
                    div.modal-header.bg-light.border-0
                        h5.modal-title Crear Coleccion
                        button.btn-close(data-bs-dismiss="modal")
                    div.modal-body
                        form(action=`/colecciones/guardar/${publicacion.id}` method="POST")
                            div.mb-3
                                label.form-label.text-muted.small Nombre de la coleccion
                                input.form-control.bg-light.border-0(type="text" name="nombreColeccion" placeholder="Ej: Paisajes, Inspiracion..." required)
                            button.btn.btn-primary.w-100(type="submit") Guardar coleccion
        div.row.g-4
            if colecciones && colecciones.length > 0
                each coleccion in colecciones
                    div.col-md-4.col-lg-3
                        div.card.h-100.border-0.shadow-sm.bg-white
                            div.card-body.d-flex.flex-column.align-items-center.text-center.py-5
                                i.bi.bi-folder-fill.text-primary.mb-3(style="font-size: 3rem;")
                                h5.card-title.fw-bold.text-dark= coleccion.nombre
                                p.small.text-muted= `${coleccion.publicaciones.length} elementos`
                                // Enlace oculto que cubre toda la tarjeta
                                a.stretched-link(href=`/colecciones/${coleccion.id}`)
            else
                div.col-12.text-center.py-5
                    i.bi.bi-folder-x.text-secondary.opacity-25(style="font-size: 4rem;")
                    h5.text-muted.mt-3 Aún no has creado ninguna colección.
                    button.btn.btn-secondary.opacity-50(type="button" data-bs-toggle="modal" data-bs-target=`#modalDenuncia-${usuario.id}`) Agrega una aqui
        


