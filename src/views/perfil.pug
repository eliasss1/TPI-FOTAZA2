extends layout

block content
    
    div.container.bg-white.rounded-1.shadow-lg.p-5.d-flex.flex-column(style="height: calc(100vh - 5rem);")
        
        //Cabecera del Perfil
        div.row.mb-5.align-items-center.border-bottom.pb-4
            div.col-md-8
                div.d-flex.align-items-center.gap-3
                    
                    div.bg-primary.text-white.rounded-circle.d-flex.align-items-center.justify-content-center.fw-bold(style="width: 70px; height: 70px; font-size: 2rem;")
                        = usuarioPerfil.username.charAt(0).toUpperCase()
                    div
                        h2.fw-bold.mb-1.text-dark= usuarioPerfil.username
                        p.text-muted.small.mb-0= usuarioPerfil.email
                    
            
            //Seguidores
            div.col-md-4.text-md-end.mt-3.mt-md-0
                div.d-flex.justify-content-end.gap-4.mb-3
                    div.text-center
                        h4.fw-bold.mb-0.text-primary= cantidadSeguidores
                        small.text-muted seguidores
                    div.text-center
                        h4.fw-bold.mb-0.text-primary= cantidadSeguidos
                        small.text-muted seguidos
                
                //Aca verifico si es mi propio perfil o el de otro
                if esPropioPerfil
                    a.btn.btn-outline-secondary.btn-sm.w-100(href="/nueva-publicacion") 
                        i.bi.bi-plus-circle-fill.me-1
                        | Nueva Publicación
                else
                    div.d-flex.gap-2.justify-content-end
                        form(action=`/perfil/${usuarioPerfil.id}/seguir` method="POST" style="margin: 0;")
                            if yaLoSigue
                                button.btn.btn-outline-secondary.btn-sm(type="submit") Dejar de seguir
                            else
                                button.btn.btn-primary.btn-sm(type="submit") Seguir
                        a.btn.btn-primary.btn-sm(href=`/chat/${usuarioPerfil.id}`) Enviar Mensaje

        //Sistema de Pestañas
        ul.nav.nav-tabs.mb-4(id="perfilTabs" role="tablist")
            li.nav-item(role="presentation")
                button.nav-link.active.fw-bold(id="mis-fotos-tab" data-bs-toggle="tab" data-bs-target="#mis-fotos" type="button" role="tab" aria-controls="mis-fotos" aria-selected="true")
                    i.bi.bi-grid-3x3-gap-fill.me-2
                    | Publicaciones Propias
            if esPropioPerfil
                li.nav-item(role="presentation")
                    button.nav-link.fw-bold(id="seguidos-tab" data-bs-toggle="tab" data-bs-target="#seguidos" type="button" role="tab" aria-controls="seguidos" aria-selected="false")
                        i.bi.bi-people-fill.me-2
                        | Contenido de usuarios que sigo

        //Contenedor de las Secciones
        div.tab-content.flex-grow-1.overflow-auto(id="perfilTabsContent")
            
            //PESTAÑA A: PUBLICACIONES PROPIAS
            div.tab-pane.fade.show.active(id="mis-fotos" role="tabpanel" aria-labelledby="mis-fotos-tab")
                
                
                div.d-flex.flex-column.flex-grow-1.h-100
                    div.row.row-cols-1.row-cols-md-3.g-4.align-items-start
                        if publicaciones && publicaciones.length > 0
                            each publicacion in publicaciones
                                div.col
                                    //El contenedor de la foto especifica
                                    div.card.bg-light.border-secondary-subtle.shadow-sm.p-2.position-relative
                                        
                                        //Capa para Marca de Agua
                                        if publicacion.imagenes && publicacion.imagenes[0] && publicacion.imagenes[0].tipo_licencia === 'con_copyright'
                                            div.position-absolute.top-50.start-50.translate-middle.w-100.text-center.pe-none(style="z-index: 10; opacity: 0.4; transform: translate(-50%, -50%) rotate(-30deg) !important;")
                                                p.text-dark.fw-bold.fs-4.m-0.text-uppercase= publicacion.imagenes[0].marca_agua

                                        //Contenedor de la Imagen
                                        div.position-relative.overflow-hidden.rounded-3
                                            if publicacion.imagenes && publicacion.imagenes[0]
                                                img.card-img-top.img-fluid(src=publicacion.imagenes[0].url_path alt=publicacion.titulo style="object-fit: cover; height: 240px; width: 100%;")
                                                
                                                // BOTON TRANSPARENTE SI HAY MAS DE 1 IMAGEN
                                                if publicacion.imagenes.length > 1
                                                    button.btn.btn-dark.btn-sm.position-absolute.top-0.end-0.m-2.opacity-75.shadow(type="button" data-bs-toggle="modal" data-bs-target=`#modalGaleria-${publicacion.id}` title="Ver todas las imágenes")
                                                        i.bi.bi-images.text-white
                                                        span.ms-1.text-white.fw-bold +#{publicacion.imagenes.length - 1}
                                            else
                                                img.card-img-top.img-fluid(src="https://picsum.photos/400/300" alt="Fotaza 2" style="object-fit: cover; height: 240px; width: 100%;")

                                        //Cuerpo de la Tarjeta
                                        div.card-body.px-2.pt-3
                                            
                                            //Esto verifica por las dudas de q no se incluya un autor
                                            if publicacion.autor
                                                a.text-primary.text-decoration-none.small.fw-bold.d-block.mb-1(href="/perfil/" + publicacion.usuario_id) #{publicacion.autor.username}
                                            else
                                                span.text-muted.small.d-block.mb-1
                                                    i.bi.bi-person-circle.me-1
                                                    | @comunidad_fotaza

                                            //Título
                                            div.d-flex.justify-content-between.align-items-center.mb-1
                                                div.d-flex.align-items-center.gap-2
                                                    h5.card-title.text-truncate.mb-0.fw-bold= publicacion.titulo
                                                    if usuario && usuario.id === publicacion.usuario_id && !publicacion.bloquear_edicion
                                                        button.btn.btn-sm.btn-link.p-0.text-secondary(type="button" data-bs-toggle="modal" data-bs-target=`#modalEditar-${publicacion.id}`)
                                                            i.bi.bi-pencil-fill

                                            //Valoracion
                                            div.d-flex.align-items-center.gap-1.mb-2
                                                span.text-warning.small
                                                    i.bi.bi-star-fill.me-1
                                                    span.fw-bold.text-dark= publicacion.dataValues.promedioValoracion || "0.0"
                                                span.text-muted.small= `(${publicacion.dataValues.cantidadVotos || 0} valoraciones)`

                                            //Descripcion limpia y etiquetas debajo
                                            p.card-text.text-muted.text-truncate.small.mb-3= publicacion.descripcion

                                            if publicacion.etiquetas && publicacion.etiquetas.length > 0
                                                .d-flex.flex-wrap.gap-1.mt-2
                                                    each tag in publicacion.etiquetas
                                                        span.badge.bg-secondary.small # #{tag.nombre}

                                            //Herramientas inferiores
                                            if usuario
                                                div.d-flex.justify-content-between.align-items-center.border-top.pt-2.mt-2
                                                    if usuario.id !== publicacion.usuario_id
                                                        form(action=`/publicaciones/interes/${publicacion.id}` method="POST" style="margin: 0;")
                                                            button.btn.btn-primary.btn-sm.d-flex.align-items-center.gap-1(type="submit")
                                                                i.bi.bi-bag-check-fill
                                                                    | Me interesa
                                                    
                                                    if publicacion.imagenes && publicacion.imagenes[0] && publicacion.imagenes[0].comentarios_abiertos === false
                                                        span.badge.bg-danger.ms-1.small ---
                                                    else
                                                        button.btn.btn-outline-secondary.btn-sm.border-0.position-relative(type="button" data-bs-toggle="modal" data-bs-target=`#modalComentario-${publicacion.id}`)
                                                            img(src="/images/comentario.png" style="height: 20px; width: 20px")

                                                    // Menu para votar
                                                    if usuario && usuario.id !== publicacion.usuario_id
                                                        .dropdown.position-relative
                                                            button.btn.btn-outline-secondary.border-0.btn-sm.position-relative(type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Valorar publicacion")
                                                                img(src="/images/estrella.png" style="height: 22px; width: 20px")
                                                            form.dropdown-menu.position-absolute.p-2.shadow(action=`/valorar/${publicacion.id}` method="POST" style="min-width: 130px; z-index: 1050;")
                                                                p.small.text-center.mb-1.fw-bold Puntaje
                                                                .d-flex.gap-1.justify-content-center
                                                                    select.form-select.form-select-sm(name="puntos" required)
                                                                        option(value="5") 5 ★
                                                                        option(value="4") 4 ★
                                                                        option(value="3") 3 ★
                                                                        option(value="2") 2 ★
                                                                        option(value="1") 1 ★
                                                                    button.btn.btn-sm.btn-warning.text-white(type="submit") Ok
                                                    else
                                                        span.p-1.text-muted
                                                            | ---        
                                                    
                                                    
                                                    if usuario.id !== publicacion.usuario_id
                                                        button.btn.btn-outline-danger.btn-sm.border-0(type="button" data-bs-toggle="modal" data-bs-target=`#modalDenuncia-${publicacion.id}`)
                                                            img(src="/images/bandera.png" style="height: 20px; width: 20px")

                                                    button.btn.btn-outline-secondary.border-0(data-bs-toggle="modal" data-bs-target=`#modalColeccion-${publicacion.id}`)
                                                        i.bi.bi-bookmark-fill.text-primary

                                    if usuario
                                        //VENTANA MODAL DE COMENTARIOS
                                        div.modal.fade(id=`modalComentario-${publicacion.id}` tabindex="-1" aria-hidden="true")
                                            div.modal-dialog.modal-dialog-centered 
                                                div.modal-content.border-0.shadow-lg
                                                    div.modal-header.bg-transparent.text-secondary 
                                                        h5.modal-title.fw-bold
                                                            i.bi.bi-shield-fill-exclamation.me-2
                                                            | Comentarios
                                                        button.btn-close.btn-close-secondary(type="button" data-bs-dismiss="modal" aria-label="Cerrar")

                                                    div.modal-body.p-4
                                                        div.d-flex.flex-column.p-2.overflow-auto(style="min-height: 150px; max-height: 500px")
                                                            if publicacion.comentarios && publicacion.comentarios.length > 0
                                                                each comentario in publicacion.comentarios
                                                                    div.gap-2.border-bottom.border-1.p-2
                                                                        .row
                                                                            strong.col-md-2 #{comentario.autor.username}
                                                                            p.col-md-7.card-text.text-muted.text-truncate.small #{comentario.texto}   
                                                                            button.col-md-1.btn.btn-outline-danger.border-0.btn-sm.position-relative(type="button")
                                                                                img.pb-1(src="/images/bandera.png" style="height: 15px; width: 15px")
                                                                            if publicacion.usuario_id == usuario.id
                                                                                
                                                                                button.col-md-1.ms-1.btn.btn-outline-danger.btn-sm.position-relative(type="button")
                                                                                    i.bi.bi-trash-fill

                                                        div.border-top.border-1.p-1
                                                            form.d-flex.gap-1(action=`/comentar/${publicacion.id}` method="POST")
                                                                .mb-3(style="width:400px") 
                                                                    textarea#texto.form-control(type="text" name="comentario" placeholder="Comenta lo que desees..." required)
                                                                button.btn.btn-primary.mb-3(type="submit" style="height: 60px") Comentar     

                                    //VENTANITA MODAL DE DENUNCIA (Solo si no es autor)
                                    if usuario.id !== publicacion.usuario_id
                                        div.modal.fade(id=`modalDenuncia-${publicacion.id}` tabindex="-1" aria-hidden="true")
                                            div.modal-dialog.modal-dialog-centered
                                                div.modal-content.border-0.shadow-lg
                                                    div.modal-header.bg-danger.text-white
                                                        h5.modal-title.fw-bold
                                                            i.bi.bi-shield-fill-exclamation.me-2
                                                            | Denunciar Publicación
                                                        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
                                                    
                                                    div.modal-body.p-4
                                                        p.text-muted.small Explicá el motivo por el cual esta imagen rompe las normas de comportamiento de la comunidad.
                                                        form(action=`/denuncia/${publicacion.id}` method="POST")
                                                            div.mb-3
                                                                label.form-label.fw-bold.text-secondary Motivo de la Denuncia
                                                                select.form-select(name="motivo" required)
                                                                    option(value="" disabled selected) Seleccioná una opcion...
                                                                    option(value="copyright") Infracción de Copyright / Plagio
                                                                    option(value="inapropiado") Contenido Inapropiado / Ofensivo
                                                                    option(value="spam") Spam o Contenido Engañoso
                                                                    option(value="otros") Otros motivos
                                                            
                                                            div.mb-3
                                                                label.form-label.fw-bold.text-secondary Descripcion / Justificacion Corta
                                                                textarea.form-control(name="justificacion" rows="3" required placeholder="Detallá de forma breve tu denuncia...")
                                                            
                                                            div.d-flex.justify-content-end.gap-2.mt-4
                                                                button.btn.btn-light(type="button" data-bs-dismiss="modal") Cancelar
                                                                button.btn.btn-danger(type="submit") Enviar Denuncia

                                    // VENTANITA MODAL PARA SUBIR A UNA COLECCION
                                    div.modal.fade(id=`modalColeccion-${publicacion.id}`)
                                        div.modal-dialog.modal-dialog-centered
                                            div.modal-content.border-0.shadow-lg
                                                div.modal-header.bg-light.border-0
                                                    h5.modal-title Guardar en Coleccion
                                                    button.btn-close(data-bs-dismiss="modal")
                                                div.modal-body

                                                    form(action=`/colecciones/guardarYCrear/${publicacion.id}` method="POST")
                                                        div.mb-3
                                                            label.form-label.text-muted.small Nombre de la Coleccion
                                                            input.form-control(type="text" name="nombreColeccion" list=`listaColecciones-${publicacion.id}` placeholder="Nueva coleccion..." required)
                                                            datalist(id=`listaColecciones-${publicacion.id}`)
                                                                if misColecciones
                                                                    each col in misColecciones
                                                                        option(value=col.nombre)
                                                        button.btn.btn-primary.w-100.mb-4(type="submit") Guardar (Individual)
                                                    
                                                    hr.text-muted

                                                    if misColecciones && misColecciones.length > 0
                                                        form(action=`/colecciones/guardarMultiples/${publicacion.id}` method="POST")
                                                            div.mb-3
                                                                label.form-label.text-muted.small Guardar en multiples (Ctrl + Clic)
                                                                select.form-select(name="coleccionesOpciones" multiple required style="height: 100px;")
                                                                    each coleccion in misColecciones
                                                                        option(value=coleccion.id)= coleccion.nombre
                                                            button.btn.btn-outline-primary.w-100(type="submit") Guardar en Seleccionadas

                                    // VENTANITA MODAL PARA EDITAR PUBLICACION (Solo autor)
                                    if usuario && usuario.id === publicacion.usuario_id && !publicacion.bloquear_edicion
                                        div.modal.fade(id=`modalEditar-${publicacion.id}`)
                                            div.modal-dialog.modal-dialog-centered
                                                div.modal-content.border-0.shadow-lg
                                                    div.modal-header.bg-light.border-0
                                                        h5.modal-title Editar Publicación
                                                        button.btn-close(data-bs-dismiss="modal")
                                                    div.modal-body
                                                        form(action=`/publicaciones/editar/${publicacion.id}` method="POST")
                                                            div.form-check.form-switch.mb-4
                                                                input.form-check-input(type="checkbox" role="switch" name="comentarios_abiertos" id=`switchComentarios-${publicacion.id}` checked=(publicacion.imagenes && publicacion.imagenes[0] && publicacion.imagenes[0].comentarios_abiertos !== false))
                                                                label.form-check-label(for=`switchComentarios-${publicacion.id}`) Permitir comentarios en esta foto
                                                            
                                                            button.btn.btn-primary.w-100(type="submit") Guardar Cambios
                                    // VENTANITA MODAL GALERIA DE IMAGENES
                                    if publicacion.imagenes && publicacion.imagenes.length > 1
                                        div.modal.fade(id=`modalGaleria-${publicacion.id}` tabindex="-1" aria-hidden="true")
                                            div.modal-dialog.modal-dialog-centered.modal-lg
                                                div.modal-content.border-0.shadow-lg.bg-dark
                                                    div.modal-header.border-0.p-2.d-flex.justify-content-end
                                                        button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
                                                    div.modal-body.p-3
                                                        // Contenedor que empuja las fotos una al lado de la otra
                                                        div.d-flex.gap-3.overflow-auto.pb-3(style="white-space: nowrap; overflow-y: hidden;")
                                                            each img in publicacion.imagenes
                                                                div.flex-shrink-0(style="width: 350px;")
                                                                    img.img-fluid.rounded-2.shadow-sm(src=img.url_path alt="Galeria" style="object-fit: cover; height: 350px; width: 100%;")
                        else
                            div.col-12.text-center.py-5.my-auto
                                i.bi.bi-camera.text-secondary.opacity-25(style="font-size: 4rem;")
                                h5.fw-bold.text-secondary.mt-3 Este usuario todavía no subió fotos

            //PESTAÑA B: PUBLICACIONES DE USUARIOS QUE SIGO
            if esPropioPerfil
                div.tab-pane.fade(id="seguidos" role="tabpanel" aria-labelledby="seguidos-tab")
                    
                    
                    div.d-flex.flex-column.flex-grow-1.h-100
                        div.row.row-cols-1.row-cols-md-3.g-4.align-items-start
                            if publicacionesSeguidos && publicacionesSeguidos.length > 0
                                each publicacion in publicacionesSeguidos
                                    div.col
                                        //El contenedor de la foto especifica
                                        div.card.bg-light.border-secondary-subtle.shadow-sm.p-2.position-relative
                                            
                                            //Capa para Marca de Agua
                                            if publicacion.imagenes && publicacion.imagenes[0] && publicacion.imagenes[0].tipo_licencia === 'con_copyright'
                                                div.position-absolute.top-50.start-50.translate-middle.w-100.text-center.pe-none(style="z-index: 10; opacity: 0.4; transform: translate(-50%, -50%) rotate(-30deg) !important;")
                                                    p.text-dark.fw-bold.fs-4.m-0.text-uppercase= publicacion.imagenes[0].marca_agua

                                            //Contenedor de la Imagen
                                            div.position-relative.overflow-hidden.rounded-3
                                                if publicacion.imagenes && publicacion.imagenes[0]
                                                    img.card-img-top.img-fluid(src=publicacion.imagenes[0].url_path alt=publicacion.titulo style="object-fit: cover; height: 240px; width: 100%;")
                                                    
                                                    // BOTON TRANSPARENTE SI HAY MAS DE 1 IMAGEN
                                                    if publicacion.imagenes.length > 1
                                                        button.btn.btn-dark.btn-sm.position-absolute.top-0.end-0.m-2.opacity-75.shadow(type="button" data-bs-toggle="modal" data-bs-target=`#modalGaleria-${publicacion.id}` title="Ver todas las imágenes")
                                                            i.bi.bi-images.text-white
                                                            span.ms-1.text-white.fw-bold +#{publicacion.imagenes.length - 1}
                                                else
                                                    img.card-img-top.img-fluid(src="https://picsum.photos/400/300" alt="Fotaza 2" style="object-fit: cover; height: 240px; width: 100%;")

                                            //Cuerpo de la Tarjeta
                                            div.card-body.px-2.pt-3
                                                
                                                //Esto verifica por las dudas de q no se incluya un autor
                                                if publicacion.autor
                                                    a.text-primary.text-decoration-none.small.fw-bold.d-block.mb-1(href="/perfil/" + publicacion.usuario_id) #{publicacion.autor.username}
                                                else
                                                    span.text-muted.small.d-block.mb-1
                                                        i.bi.bi-person-circle.me-1
                                                        | @comunidad_fotaza

                                                //Título
                                                div.d-flex.justify-content-between.align-items-center.mb-1
                                                    h5.card-title.text-truncate.mb-0.fw-bold= publicacion.titulo

                                                //Valoracion
                                                div.d-flex.align-items-center.gap-1.mb-2
                                                    span.text-warning.small
                                                        i.bi.bi-star-fill.me-1
                                                        span.fw-bold.text-dark= publicacion.dataValues.promedioValoracion || "0.0"
                                                    span.text-muted.small= `(${publicacion.dataValues.cantidadVotos || 0} valoraciones)`

                                                //Descripcion limpia y etiquetas debajo
                                                p.card-text.text-muted.text-truncate.small.mb-3= publicacion.descripcion

                                                if publicacion.etiquetas && publicacion.etiquetas.length > 0
                                                    .d-flex.flex-wrap.gap-1.mt-2
                                                        each tag in publicacion.etiquetas
                                                            span.badge.bg-secondary.small # #{tag.nombre}

                                                //Herramientas inferiores
                                                if usuario
                                                    div.d-flex.justify-content-between.align-items-center.border-top.pt-2.mt-2
                                                        if usuario.id !== publicacion.usuario_id
                                                            form(action=`/publicaciones/interes/${publicacion.id}` method="POST" style="margin: 0;")
                                                                button.btn.btn-primary.btn-sm.d-flex.align-items-center.gap-1(type="submit")
                                                                    i.bi.bi-bag-check-fill
                                                                        | Me interesa
                                                        
                                                        if publicacion.imagenes && publicacion.imagenes[0] && publicacion.imagenes[0].comentarios_abiertos === false
                                                            span.badge.bg-danger.ms-1.small ---
                                                        else
                                                            button.btn.btn-outline-secondary.btn-sm.border-0.position-relative(type="button" data-bs-toggle="modal" data-bs-target=`#modalComentario-${publicacion.id}`)
                                                                img(src="/images/comentario.png" style="height: 20px; width: 20px")

                                                        // Menu para votar
                                                        if usuario && usuario.id !== publicacion.usuario_id
                                                            .dropdown.position-relative
                                                                button.btn.btn-outline-secondary.border-0.btn-sm.position-relative(type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Valorar publicacion")
                                                                    img(src="/images/estrella.png" style="height: 22px; width: 20px")
                                                                form.dropdown-menu.position-absolute.p-2.shadow(action=`/valorar/${publicacion.id}` method="POST" style="min-width: 130px; z-index: 1050;")
                                                                    p.small.text-center.mb-1.fw-bold Puntaje
                                                                    .d-flex.gap-1.justify-content-center
                                                                        select.form-select.form-select-sm(name="puntos" required)
                                                                            option(value="5") 5 ★
                                                                            option(value="4") 4 ★
                                                                            option(value="3") 3 ★
                                                                            option(value="2") 2 ★
                                                                            option(value="1") 1 ★
                                                                        button.btn.btn-sm.btn-warning.text-white(type="submit") Ok
                                                        else
                                                            span.p-1.text-muted
                                                                | ---        
                                                        
                                                        
                                                        if usuario.id !== publicacion.usuario_id
                                                            button.btn.btn-outline-danger.btn-sm.border-0(type="button" data-bs-toggle="modal" data-bs-target=`#modalDenuncia-${publicacion.id}`)
                                                                img(src="/images/bandera.png" style="height: 20px; width: 20px")

                                                        button.btn.btn-outline-secondary.border-0(data-bs-toggle="modal" data-bs-target=`#modalColeccion-${publicacion.id}`)
                                                            i.bi.bi-bookmark-fill.text-primary
                                        if usuario
                                        //VENTANA MODAL DE COMENTARIOS
                                        div.modal.fade(id=`modalComentario-${publicacion.id}` tabindex="-1" aria-hidden="true")
                                            div.modal-dialog.modal-dialog-centered 
                                                div.modal-content.border-0.shadow-lg
                                                    div.modal-header.bg-transparent.text-secondary 
                                                        h5.modal-title.fw-bold
                                                            i.bi.bi-shield-fill-exclamation.me-2
                                                            | Comentarios
                                                        button.btn-close.btn-close-secondary(type="button" data-bs-dismiss="modal" aria-label="Cerrar")

                                                    div.modal-body.p-4
                                                        div.d-flex.flex-column.p-2.overflow-auto(style="min-height: 150px; max-height: 500px")
                                                            if publicacion.comentarios && publicacion.comentarios.length > 0
                                                                each comentario in publicacion.comentarios
                                                                    div.gap-2.border-bottom.border-1.p-2
                                                                        .row
                                                                            strong.col-md-2 #{comentario.autor.username}
                                                                            p.col-md-7.card-text.text-muted.text-truncate.small #{comentario.texto}   
                                                                            button.col-md-1.btn.btn-outline-danger.border-0.btn-sm.position-relative(type="button")
                                                                                img.pb-1(src="/images/bandera.png" style="height: 15px; width: 15px")
                                                                            if publicacion.usuario_id == usuario.id
                                                                                
                                                                                button.col-md-1.ms-1.btn.btn-outline-danger.btn-sm.position-relative(type="button")
                                                                                    i.bi.bi-trash-fill

                                                        div.border-top.border-1.p-1
                                                            form.d-flex.gap-1(action=`/comentar/${publicacion.id}` method="POST")
                                                                .mb-3(style="width:400px") 
                                                                    textarea#texto.form-control(type="text" name="comentario" placeholder="Comenta lo que desees..." required)
                                                                button.btn.btn-primary.mb-3(type="submit" style="height: 60px") Comentar     

                                        //VENTANITA MODAL DE DENUNCIA (Solo si no es autor)
                                        if usuario.id !== publicacion.usuario_id
                                            div.modal.fade(id=`modalDenuncia-${publicacion.id}` tabindex="-1" aria-hidden="true")
                                                div.modal-dialog.modal-dialog-centered
                                                    div.modal-content.border-0.shadow-lg
                                                        div.modal-header.bg-danger.text-white
                                                            h5.modal-title.fw-bold
                                                                i.bi.bi-shield-fill-exclamation.me-2
                                                                | Denunciar Publicación
                                                            button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
                                                        
                                                        div.modal-body.p-4
                                                            p.text-muted.small Explicá el motivo por el cual esta imagen rompe las normas de comportamiento de la comunidad.
                                                            form(action=`/denuncia/${publicacion.id}` method="POST")
                                                                div.mb-3
                                                                    label.form-label.fw-bold.text-secondary Motivo de la Denuncia
                                                                    select.form-select(name="motivo" required)
                                                                        option(value="" disabled selected) Seleccioná una opcion...
                                                                        option(value="copyright") Infracción de Copyright / Plagio
                                                                        option(value="inapropiado") Contenido Inapropiado / Ofensivo
                                                                        option(value="spam") Spam o Contenido Engañoso
                                                                        option(value="otros") Otros motivos
                                                                
                                                                div.mb-3
                                                                    label.form-label.fw-bold.text-secondary Descripcion / Justificacion Corta
                                                                    textarea.form-control(name="justificacion" rows="3" required placeholder="Detallá de forma breve tu denuncia...")
                                                                
                                                                div.d-flex.justify-content-end.gap-2.mt-4
                                                                    button.btn.btn-light(type="button" data-bs-dismiss="modal") Cancelar
                                                                    button.btn.btn-danger(type="submit") Enviar Denuncia

                                        // VENTANITA MODAL PARA SUBIR A UNA COLECCION
                                        div.modal.fade(id=`modalColeccion-${publicacion.id}`)
                                            div.modal-dialog.modal-dialog-centered
                                                div.modal-content.border-0.shadow-lg
                                                    div.modal-header.bg-light.border-0
                                                        h5.modal-title Guardar en Coleccion
                                                        button.btn-close(data-bs-dismiss="modal")
                                                    div.modal-body

                                                        form(action=`/colecciones/guardarYCrear/${publicacion.id}` method="POST")
                                                            div.mb-3
                                                                label.form-label.text-muted.small Nombre de la Coleccion
                                                                input.form-control(type="text" name="nombreColeccion" list=`listaColecciones-${publicacion.id}` placeholder="Nueva coleccion..." required)
                                                                datalist(id=`listaColecciones-${publicacion.id}`)
                                                                    if misColecciones
                                                                        each col in misColecciones
                                                                            option(value=col.nombre)
                                                            button.btn.btn-primary.w-100.mb-4(type="submit") Guardar (Individual)
                                                        
                                                        hr.text-muted

                                                        if misColecciones && misColecciones.length > 0
                                                            form(action=`/colecciones/guardarMultiples/${publicacion.id}` method="POST")
                                                                div.mb-3
                                                                    label.form-label.text-muted.small Guardar en multiples (Ctrl + Clic)
                                                                    select.form-select(name="coleccionesOpciones" multiple required style="height: 100px;")
                                                                        each coleccion in misColecciones
                                                                            option(value=coleccion.id)= coleccion.nombre
                                                                button.btn.btn-outline-primary.w-100(type="submit") Guardar en Seleccionadas
                                        // VENTANITA MODAL GALERIA DE IMAGENES
                                        if publicacion.imagenes && publicacion.imagenes.length > 1
                                            div.modal.fade(id=`modalGaleria-${publicacion.id}` tabindex="-1" aria-hidden="true")
                                                div.modal-dialog.modal-dialog-centered.modal-lg
                                                    div.modal-content.border-0.shadow-lg.bg-dark
                                                        div.modal-header.border-0.p-2.d-flex.justify-content-end
                                                            button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
                                                        div.modal-body.p-3
                                                            // Contenedor que empuja las fotos una al lado de la otra
                                                            div.d-flex.gap-3.overflow-auto.pb-3(style="white-space: nowrap; overflow-y: hidden;")
                                                                each img in publicacion.imagenes
                                                                    div.flex-shrink-0(style="width: 350px;")
                                                                        img.img-fluid.rounded-2.shadow-sm(src=img.url_path alt="Galeria" style="object-fit: cover; height: 350px; width: 100%;")

                            else
                                div.col-12.text-center.py-5.my-auto
                                    i.bi.bi-people.text-secondary.opacity-25(style="font-size: 4rem;")
                                    h5.fw-bold.text-secondary.mt-3 No hay novedades por acá
                                    p.text-muted Las fotos de los artistas que sigas aparecerán en este bloque.

        //Paginacion
        nav.mt-auto.pt-4(aria-label="Paginación de perfil")
            ul.pagination.justify-content-center.mb-0
                li.page-item.disabled
                    a.page-link(href="#") Anterior
                li.page-item.active
                    a.page-link(href="#") 1
                li.page-item
                    a.page-link(href="#") Siguiente