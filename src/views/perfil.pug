                                                        div.mb-3
                                                            label.form-label.text-muted.small Nombre de la Coleccion
                                                            input.form-control(type="text" name="nombreColeccion" list=`listaColecciones-${publicacion.id}` placeholder="Nueva coleccion..." required)
                                                            datalist(id=`listaColecciones-${publicacion.id}`)
                                                                if misColecciones
                                                                    each col in misColecciones
                                                                        option(value=col.nombre)
                                                        button.btn.btn-primary.w-100.mb-4(type="submit") Guardar (Individual)
                                                    
                                                    hr.text-muted

                                                    if misColecciones && misColecciones.length > 0
                                                        form(action=`/colecciones/guardarMultiples/${publicacion.id}` method="POST")
                                                            div.mb-3
                                                                label.form-label.text-muted.small Guardar en multiples (Ctrl + Clic)
                                                                select.form-select(name="coleccionesOpciones" multiple required style="height: 100px;")
                                                                    each coleccion in misColecciones
                                                                        option(value=coleccion.id)= coleccion.nombre
                                                            button.btn.btn-outline-primary.w-100(type="submit") Guardar en Seleccionadas

                        else
                            div.col-12.text-center.py-5.my-auto
                                i.bi.bi-people.text-secondary.opacity-25(style="font-size: 4rem;")
                                h5.fw-bold.text-secondary.mt-3 No hay novedades por acá
                                p.text-muted Las fotos de los artistas que sigas aparecerán en este bloque.

        //Paginacion
        nav.mt-auto.pt-4(aria-label="Paginación de perfil")
            ul.pagination.justify-content-center.mb-0
                li.page-item.disabled
                    a.page-link(href="#") Anterior
                li.page-item.active
                    a.page-link(href="#") 1
                li.page-item
                    a.page-link(href="#") Siguiente