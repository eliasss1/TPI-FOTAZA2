extends layout

block content
    style.
        .opcion-filtro {
            width: 200px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            cursor: pointer;
        }
        .opcion-filtro:hover {
            width: 210px;
            background-color: rgba(20, 86, 184, 0.85);
        }
        
        .opcion-filtro:hover h5 {
            color: white !important;
        }

    div.container.bg-light.shadow-lg.p-4.rounded-1(style="height: calc(100vh - 5rem); overflow: auto")
        h2.text-muted.text-center.mb-4 Gestión de Denuncias y Moderación
        
        
        div.border-bottom.border-1.mb-4.p-0.d-flex.bg-white.shadow-sm.rounded
            div.p-3(style="width: 300px")
                h4.text-secondary.mb-0.mt-1 Filtros de Menú
            
            a.opcion-filtro.border-start.border-1(href="/moderacion")
                h5.text-muted.py-auto.px-3.mb-0 Denuncias Recibidas
            
            a.opcion-filtro.border-start.border-1(href="/moderacion?filtro=historial")
                h5.text-muted.py-auto.px-3.mb-0 Historial de Bajas
            
            a.opcion-filtro.border-start.border-1(href="/moderacion?filtro=inactivos")
                h5.text-muted.py-auto.px-3.mb-0 Usuarios Inactivos

        
        div.d-flex.flex-column.p-1.bg-white.shadow-sm.rounded(style="width: 100%; min-height: 500px")
            if listaDenuncias && listaDenuncias.length > 0
                each denuncia in listaDenuncias
                    div.d-flex.border-bottom.border-1.bg-light.shadow-sm.mb-2.p-2(style="overflow: hidden;")
                        
                        n
                        div.border-end.border-2.px-3(style="min-width: 250px;")
                            h5.card-title.fw-bold= denuncia.titulo
                            p.card-text.text-muted Subido por: @#{denuncia.autor.username}
                        
                        
                        div.px-3.flex-grow-1
                            p.text-danger.fw-semibold.mb-1 Motivo: "#{denuncia.motivo}"
                            p.small.text-secondary.mb-0 Justificación: "#{denuncia.justificacion}"
                        
                        
                        div.d-flex.px-4.py-2.gap-2.align-items-center
                            
                            form(action=`/moderacion/rechazar/${denuncia.id}` method="POST" style="margin: 0;")
                                button.btn.btn-danger.text-white(type="submit" style="height: 40px;") Rechazar
                            
                            
                            form(action=`/moderacion/aceptar/${denuncia.id}` method="POST" style="margin: 0;")
                                button.btn.btn-success.text-white(type="submit" style="height: 40px;") Aceptar
            else
                
                div.text-center.py-5.my-auto
                    i.bi.bi-shield-check.text-secondary.opacity-25(style="font-size: 4rem;")
                    h5.fw-bold.text-secondary.mt-3 No hay denuncias pendientes. ¡Todo en orden!

        
        if totalPaginas > 1
            nav.mt-auto.pt-4(aria-label="Paginacion de denuncias")
                ul.pagination.justify-content-center.mb-0
                    li(class=`page-item ${paginaActual === 1 ? 'disabled' : ''}`)
                        a.page-link(href=`/moderacion?page=${paginaActual - 1}`) Anterior
                    
                    - var n = 1;
                    while n <= totalPaginas
                        li(class=`page-item ${paginaActual === n ? 'active' : ''}`)
                            a.page-link(href=`/moderacion?page=${n}`)= n++
                    
                    li(class=`page-item ${paginaActual === totalPaginas ? 'disabled' : ''}`)
                        a.page-link(href=`/moderacion?page=${paginaActual + 1}`) Siguiente