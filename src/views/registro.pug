extends layout

block content
  div.row.justify-content-center
    div.col-md-6
      div.card.shadow
        div.card-body
          h2.text-center.mb-4 Registro de Usuario
          
          //- El formulario apunta a la ruta POST que tenemos en express
          form(action="/auth/registro" method="POST")
            div.mb-3
              label.form-label(for="nombre") Nombre
              input#nombre.form-control(type="text" name="nombre" required placeholder="Tu nombre")
            
            div.mb-3
              label.form-label(for="email") Correo Electrónico
              input#email.form-control(type="email" name="email" required placeholder="ejemplo@correo.com")
            
            div.mb-3
              label.form-label(for="password") Contraseña
              input#password.form-control(type="password" name="password" required)
            
            button.btn.btn-primary.w-100(type="submit") Registrarse
            
          div.mt-3.text-center
            p ¿Ya tienes cuenta? 
              a(href="/auth/login") Inicia sesión aquí